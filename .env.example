# Copied to .env by update.sh on first run; it then prompts for anything empty.
# .env is gitignored. Values are pushed to the Worker as secrets.

# Cloudflare API token (Workers Scripts:Edit, D1:Edit). Leave empty if you ran `npx wrangler login`.
CLOUDFLARE_API_TOKEN=
# Only needed when the token can see more than one account.
CLOUDFLARE_ACCOUNT_ID=

# From @BotFather.
BOT_TOKEN=
# Random string Telegram sends back on every webhook call. Generated if empty.
WEBHOOK_SECRET=
# Your account IDs, comma-separated. Send /id to the bot to see yours.
ADMIN_IDS=
# The forum supergroup's ID (starts with -100). Send /id in the group to see it.
GROUP_ID=
# Filled from `wrangler deploy` output; set it yourself if you use a custom domain.
WORKER_URL=

# Optional starting values. The /settings panel in the group overrides them
# (and can set FORWARD_SOURCE per topic); empty = built-in default.
# VERIFY: 1/0 (default 1) · RATE_LIMIT_PER_MIN: 0 = off (default 20)
# FORWARD_SOURCE: all / channel / none (default all) · RETENTION_DAYS (default 90)
# RECEIPTS: 1/0, 👌/👀 marks on the latest admin message in a guest topic (default 1)
VERIFY=
RATE_LIMIT_PER_MIN=
FORWARD_SOURCE=
RETENTION_DAYS=
RECEIPTS=
# Use \n for line breaks. Empty = built-in bilingual greeting.
WELCOME_TEXT=
